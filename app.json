{
  "expo": {
    "name": "Hindu Calendar - Panchang",
    "slug": "hindu-calendar-panchang",
    "platforms": ["android"],
    "scheme": "hinducalendar",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/images/panchag-loog-new.png",
    "splash": {
      "image": "./assets/images/logo_without_background.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF8EC"
    },
    "web": {
      "favicon": "./assets/images/panchag-loog-new.png"
    },
    "android": {
      "package": "com.pooniya.hinducalendar",
      "versionCode": 5,
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo_without_background.png",
        "backgroundColor": "#FFF8EC"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo_without_background.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#FFF8EC"
        }
      ],
      "expo-sqlite",
      "expo-notifications",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "android": ["en", "hi", "bn", "mr", "te", "ta", "gu", "ur", "kn", "or", "ml", "pa"],
            "ios": ["en", "hi", "bn", "mr", "te", "ta", "gu", "ur", "kn", "or", "ml", "pa"]
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3d707d4a-ae11-4e03-a1f3-3dd046bc4bc2"
      }
    }
  }
}
